{
  "name": "bradd-stone-creative-leadership",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/site.test.mjs tests/hero-interaction.test.mjs",
    "test:layout": "node --test tests/layout.test.mjs",
    "test:a11y": "node --test tests/a11y.test.mjs",
    "lint": "eslint src --max-warnings=0",
    "gates": "npm run lint && npm run build && npm test && npm run test:layout && npm run test:a11y",
    "shots": "node scripts/shots.mjs",
    "shots:cinematic": "node scripts/shots.mjs --fx=webgl --live --viewport=desktop --out=outputs/cinematic",
    "shots:baseline": "node scripts/shots.mjs --out=outputs/baseline",
    "visual-diff": "node scripts/visual-diff.mjs",
    "review": "node scripts/design-review.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@react-three/fiber": "^9.7.0",
    "motion": "^13.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.2.1"
  },
  "type": "module"
}
