---
import { url } from '../utils/urls';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PortraitExplorer from '../components/PortraitExplorer.astro';
import PortraitRevision from '../components/PortraitRevision.astro';
import {projects,work} from '../data/projects';
---
<Base>
 <section class="home-hero">
  <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> Art direction · Design judgment · Applied AI</p><h1>More possibilities.<br/><em>Better decisions.</em></h1><p class="hero-intro">AI makes more options.<br/>Judgment decides which one is good.</p><p class="hero-bio">I’m Bradd McBrearty. For 15+ years, I’ve made, directed, and critiqued visual work for games. Now I bring that same quality bar to AI.</p><div class="hero-actions"><a class="button" href="#selected-work">Explore the work <span aria-hidden="true">↘</span></a><a class="text-link" href={url('/judging-ai-output/')}>How I judge it <span aria-hidden="true">↗</span></a></div></div>
  <div class="hero-art"><div class="art-coordinate">SELECTED STUDY / 001</div><div class="portrait-triptych"><img class="portrait-back" src={url('/media/evidence/portrait-alba-0.webp')} srcset={`${url('/media/evidence/portrait-alba-0-thumb.webp')} 420w, ${url('/media/evidence/portrait-alba-0.webp')} 840w`} sizes="(max-width: 600px) 45vw, 24vw" alt="" width="630" height="880"/><img class="portrait-front" src={url('/media/evidence/portrait-tudor-0.webp')} srcset={`${url('/media/evidence/portrait-tudor-0-thumb.webp')} 420w, ${url('/media/evidence/portrait-tudor-0.webp')} 840w`} sizes="(max-width: 600px) 45vw, 24vw" alt="Henry VII, one of 84 AI-generated historical portraits art-directed by Bradd McBrearty." fetchpriority="high" width="630" height="880"/><img class="portrait-side" src={url('/media/evidence/portrait-plantagenet-1.webp')} srcset={`${url('/media/evidence/portrait-plantagenet-1-thumb.webp')} 420w, ${url('/media/evidence/portrait-plantagenet-1.webp')} 840w`} sizes="(max-width: 600px) 45vw, 24vw" alt="" width="630" height="880"/></div><div class="art-caption"><span><strong>84 portraits. One considered world.</strong><br/>Overlords & Outlaws / AI-generated, human-directed</span><a href={url('/projects/overlords-and-outlaws/')} aria-label="Explore Overlords and Outlaws">↗</a></div></div>
  <div class="hero-baseline"><span>Creative & Technical Art Director</span><span>Oceanside, California / Working everywhere</span><span aria-hidden="true">Scroll to explore ↓</span></div>
 </section>
 <section class="craft-band" aria-label="Selected production experience"><p>The craft behind the judgment</p><div><span>Tetris Beat</span><span>Ultimate Rivals</span><span>Disney Enchanted Tales</span><span>Roblox experiences</span></div><a href={url('/work/')}>See my contributions ↗</a></section>
 <section class="selected-section wrap" id="selected-work">
  <div class="section-heading" data-reveal><div><p class="eyebrow">Selected projects / 2026</p><h2>Good output<br/>starts with <em>good judgment.</em></h2></div><p>What I made. What I questioned.<br/>And the decisions that made the work better.</p></div>
  <div class="project-grid">{projects.slice(0,3).map((p,i)=><ProjectCard project={p} index={i}/>)}</div>
  <a class="text-link all-projects" href={url('/projects/')}>Explore all five projects <span aria-hidden="true">↗</span></a>
 </section>
 <section class="judgment-feature dark-section">
  <div class="wrap judgment-grid"><div data-reveal><p class="eyebrow">A design decision, up close</p><h2>Attractive<br/>isn’t the same<br/>as <em>right.</em></h2><p class="lead">The portrait looked convincing. The tower behind a sixteenth-century king belonged to the nineteenth century.</p><p class="lead">The fix was precise: correct the setting and preserve everything that already worked.</p><a class="text-link" href={url('/projects/overlords-and-outlaws/')}>Inside the design decision ↗</a></div><PortraitRevision compact/></div>
 </section>
 <div class="wrap"><PortraitExplorer/></div>
 <section class="work-feature wrap"><div class="section-heading"><div><p class="eyebrow">Before generative AI, there was the craft</p><h2>I’ve made the work.<br/><em>I know what it takes.</em></h2></div><a class="text-link" href={url('/work/')}>Explore the production work ↗</a></div><div class="craft-grid">{[work[0],work[2],work[3]].map(w=><a class="craft-card" href={url(`/work/#${w.id}`)}><div class="craft-img"><img src={url(`/media/evidence/${w.id}.webp`)} alt={`${w.title} from ${w.project}`} loading="lazy" width="600" height="450"/></div><p class="eyebrow">{w.project}</p><h3>{w.title}</h3><p>{w.role}</p></a>)}</div></section>
 <section class="philosophy"><img src={url('/media/generated/judgment-paper-study.webp')} alt="" loading="lazy" width="1536" height="1024"/><div class="wrap"><p class="eyebrow">The tools change. The standard stays.</p><h2>AI makes the work faster.<br/>It doesn’t get<br/><em>a lower bar.</em></h2><a class="button light" href={url('/judging-ai-output/')}>Read my eight principles ↗</a><p class="art-disclosure">Original AI-generated paper study / Art-directed for this portfolio</p></div></section>
</Base>
