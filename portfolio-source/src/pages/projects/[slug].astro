---
import { url } from '../../utils/urls';
import Base from '../../layouts/Base.astro';
import PortraitExplorer from '../../components/PortraitExplorer.astro';
import PortraitRevision from '../../components/PortraitRevision.astro';
import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}));}
const {project:p,next}=Astro.props;
---
<Base title={`${p.title} — Bradd McBrearty`} description={p.description}>
 <div class="wrap"><header class="case-hero"><a class="back-link" href={url('/projects/')}>← All selected projects</a><p class="eyebrow">{p.eyebrow}</p><h1>{p.title}</h1><p class="case-summary">{p.summary}</p><div class="case-actions"><a class="button" href={p.live}>{p.slug==='phase-rs-ai-measurement'?'See the contributions':'Explore the live project'} ↗</a><a class="text-link" href={p.repo}>Repository ↗</a></div></header>
 <figure class="case-cover">{p.image?<img src={url(`/media/evidence/${p.image}`)} alt={p.alt} width="1280" height="720" fetchpriority="high"/>:<div class="seed-art" aria-hidden="true"><span>same seed.</span><span>same rules.</span><span class="serif">credible evidence.</span><div class="seed-lines"><i></i><i></i><i></i></div></div>}</figure>
 <dl class="case-facts"><div><dt>My contribution</dt><dd>{p.role}</dd></div><div><dt>Status</dt><dd>{p.status}</dd></div><div><dt>Built</dt><dd>{p.date}</dd></div></dl>
 <section class="decision-banner"><p class="eyebrow">The design judgment</p><h2>{p.decision}</h2><p>{p.decisionBody}</p></section>
 <div class="case-story"><aside class="case-side"><p class="eyebrow">Behind the finished surface</p><h2>The constraints.<br/>The choices.<br/><em>The work.</em></h2></aside><div class="case-prose">{p.sections.map(s=><section><h2>{s.title}</h2><p>{s.body}</p></section>)}</div></div>
 {p.slug==='overlords-and-outlaws'&&<section class="revision-section"><div class="section-heading"><div><p class="eyebrow">A specific problem. A precise correction.</p><h2>Keep the sitter.<br/><em>Correct the century.</em></h2></div><p>Henry VII’s revision record shows the original, the edit instruction, and the installed correction.</p></div><PortraitRevision/></section>}
 {p.slug==='overlords-and-outlaws'&&<><PortraitExplorer/><section class="audit-bars"><p class="eyebrow">What the audit actually found</p><h3>A regression is still a result.</h3><div class="bar"><span>Earlier V2 / 1,087 of 4,427 opportunities / 24.6%</span><i style="width:82%"></i></div><div class="bar"><span>Final V3 / 621 of 5,372 opportunities / 11.6%</span><i style="width:38.67%"></i></div><p class="small-note">Plausible tradeoff candidates from automated continuations on the same 200 game seeds. The denominators differ because the rules change the decisions encountered. These are not human judgments of fun. Final V3 did not demonstrate more meaningful choices; that design question remains open.</p></section></>}
 {p.slug==='ai-art-direction-review'&&<section aria-label="The four-part review rubric" class="rubric-grid">{[['01','Verdict','Two blunt sentences that state whether the design works.'],['02','Blockers','Name the problem, cite the screenshot, explain the cost, and specify the fix.'],['03','Priorities','Rank the changes that would make the largest meaningful improvement.'],['04','Keep-list','Name what is working so the next pass does not remove it.']].map(([n,t,b])=><article><span>{n}</span><h3>{t}</h3><p>{b}</p></article>)}</section>}
 {p.slug==='phase-rs-ai-measurement'&&<section aria-label="Results from the separate 100-pair experiment in PR 6777" class="paired-grid"><div><strong>98</strong><p>Matching outcome records</p></div><div><strong>2</strong><p>Timeout-to-win completion shifts</p></div><div><strong>0</strong><p>Divergent results in this run</p></div></section>}
 <section class="evidence-panel"><p class="eyebrow">Look closer</p><h2>The evidence stays attached.</h2><div class="evidence-links">{p.evidence.map(e=><a href={e.url}>{e.label}<span aria-hidden="true">↗</span></a>)}</div><p class="limits"><strong>Scope & limits.</strong> {p.limits}</p></section>
 <p class="credits"><strong>Credits.</strong> {p.credit}<br/><strong>Tools.</strong> {p.stack}</p>
 <a href={url(`/projects/${next.slug}/`)} class="next-case"><span>Next project ↗</span><strong>{next.title}</strong></a></div>
</Base>
