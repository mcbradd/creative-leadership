---
import { url } from '../utils/urls';
import Base from '../layouts/Base.astro';
import Filters from '../components/Filters.astro';
import {work} from '../data/projects';
---
<Base title="The craft behind the judgment — Bradd McBrearty" description="Selected art direction, real-time visuals, characters, and environments from Tetris Beat, Ultimate Rivals, Disney, and Roblox projects. Specific contributions and credits.">
<div class="wrap"><header class="page-intro"><p class="eyebrow">Selected production work</p><h1>The craft behind<br/><em>the judgment.</em></h1><p class="lead">I’ve built the shaders, animated the characters, shaped the environments, and directed the pipelines. That practical experience is the standard I bring to AI output.</p></header><Filters options={['Direction','Technical art','Characters','Environments']} target=".work-tile"/>
<div class="work-grid">{work.map(w=><article class="work-tile" id={w.id} data-category={w.kind}><figure><a href={w.url} aria-label={`View ${w.title} on ArtStation`}><img src={url(`/media/evidence/${w.id}.webp`)} alt={`${w.title} — ${w.project}`} width="800" height="600" loading="lazy"/></a><button class="gallery-open" data-gallery={w.id} aria-label={`Inspect ${w.title}`}>Inspect image ↗</button></figure><p class="eyebrow">{w.project}</p><h2>{w.title}</h2><p class="work-role">{w.role}</p><p class="work-description">{w.copy}</p><p class="credit">{w.credit}</p><div class="work-links"><a class="text-link" href={w.url}>Full work & credits ↗</a>{w.video&&<a class="text-link" href={w.video}>Watch the work ↗</a>}</div></article>)}</div>
{work.map(w=><dialog class="gallery-dialog" id={`gallery-${w.id}`} aria-labelledby={`gallery-title-${w.id}`}><button class="gallery-close" autofocus>Close image ×</button><img src={url(`/media/evidence/${w.id}.webp`)} alt={`${w.title} — ${w.project}`} loading="lazy" width="800" height="600"/><h2 id={`gallery-title-${w.id}`}>{w.title}</h2><p>{w.credit}</p><a class="text-link" href={w.url}>Original work & full credits ↗</a></dialog>)}
<p class="credits">Images are selected from my public ArtStation portfolio. Studio work is collaborative; each piece names my contribution and its collaborators. The original pages hold additional images, video, and credits.</p></div>
</Base>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-gallery]').forEach(button=>button.addEventListener('click',()=>{const dialog=document.getElementById(`gallery-${button.dataset.gallery}`) as HTMLDialogElement;dialog.showModal();}));
document.querySelectorAll<HTMLDialogElement>('.gallery-dialog').forEach(dialog=>{dialog.querySelector('.gallery-close')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog){const box=dialog.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)dialog.close();}});});
</script>
